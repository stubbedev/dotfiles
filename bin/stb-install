#!/usr/bin/env bash
set -euo pipefail

# stb-install — bootstrap script for non-NixOS hosts.
#
# Steps:
#   1. Symlink ${HOME}/.stubbe to this repo (the rest of the config assumes it).
#   2. Install nix if missing.
#   3. Configure /etc/nix/nix.conf for flakes + this user as trusted.
#   4. Build the flake's activation package and run it; every switch after
#      this one goes through the `home-manager` binary it installs.
#
# Everything else (fonts, docker, dev tools, IDE licenses, ...) is owned
# by home-manager modules under modules/ — don't add it here.

is_root() {
  [ "$(id -u)" -eq 0 ]
}

is_nixos() {
  grep -q '^ID=nixos' /etc/os-release 2>/dev/null
}

main() {
  echo "STUBBEDEV DOTFILES INSTALLER"

  if is_root; then
    echo "Do not run this with sudo. Run it as your user; sudo is requested per-step." >&2
    exit 1
  fi

  if is_nixos; then
    echo "This installer targets non-NixOS hosts. On NixOS, build the flake directly:" >&2
    echo "  nixos-rebuild switch --flake \"$PWD#<host>\"" >&2
    exit 1
  fi

  read -rp "Bootstrap home-manager from this repo? [y/N] " reply
  case "$reply" in
    y | Y) ;;
    *)
      echo "Cancelling."
      exit 0
      ;;
  esac

  link_dotfiles
  install_nix
  configure_nix
  switch_home_manager
}

link_dotfiles() {
  local target="$HOME/.stubbe"

  # Covers both "already the right symlink" and "the repo IS ~/.stubbe",
  # because readlink -f on a plain directory returns the directory. The
  # second case used to fall through to the rm below, which deleted the
  # repository out from under the running script.
  if [ "$(readlink -f "$target" 2>/dev/null)" = "$PWD" ]; then
    return 0
  fi

  # Anything else already sitting at ~/.stubbe is somebody's data, not ours
  # to delete. Only a symlink pointing elsewhere gets replaced.
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "$target exists and is not a symlink. Move it aside and re-run." >&2
    exit 1
  fi

  rm -f "$target"
  ln -s "$PWD" "$target"
}

install_nix() {
  # Only bootstrap a *missing* nix. Unlike the lix installer this replaced,
  # the Determinate installer is not an in-place upgrader: it refuses when it
  # finds an existing install, which under `set -e` would abort every re-run
  # of this script on an already-provisioned host.
  #
  # Determinate rather than lix or upstream, for the evaluator: nix's is
  # single-threaded, and a full system eval of this flake is ~36s of one
  # saturated core. Determinate's `eval-cores` splits it (3-4x measured). It
  # has to come from the installer — nix-src cannot be built from nixpkgs
  # (its boost coroutine patch rejects against boost 1.89) and its prebuilt
  # binaries live behind an authenticated FlakeHub Cache, so there is no
  # flake input that would let modules/nix.nix just set `nix.package`.
  if [ -e /nix/var/nix/profiles/default/bin/nix ] || command -v nix >/dev/null 2>&1; then
    return 0
  fi
  curl -sSf -L https://install.determinate.systems/nix | sh -s -- install --no-confirm
}

configure_nix() {
  local conf="/etc/nix/nix.conf"
  local tmpfile original_perms needs_update=false
  tmpfile=$(mktemp)
  trap 'rm -f "$tmpfile"' RETURN
  original_perms=$(stat -c '%a' "$conf")
  cp -f "$conf" "$tmpfile"

  # Settings the flake-based setup depends on. trusted-users lets this user
  # add substituters / use the daemon. keep-outputs/keep-derivations stop GC
  # from evicting build inputs the dev workflow keeps re-using.
  ensure_setting() {
    local key="$1" line="$2"
    if ! grep -Fxq "$line" "$tmpfile"; then
      sed -i "/^${key}/d" "$tmpfile"
      printf '%s\n' "$line" >> "$tmpfile"
      needs_update=true
    fi
  }

  ensure_setting "experimental-features" "experimental-features = nix-command flakes"
  ensure_setting "trusted-users"         "trusted-users = root $USER"
  ensure_setting "sandbox"               "sandbox = relaxed"
  ensure_setting "keep-outputs"          "keep-outputs = true"
  ensure_setting "keep-derivations"      "keep-derivations = true"

  if [ "$needs_update" = true ]; then
    sudo cp -f "$tmpfile" "$conf"
    sudo chmod "$original_perms" "$conf"
  fi
}

switch_home_manager() {
  local flake_path activation
  flake_path=$(readlink -f "$HOME/.stubbe")

  # --impure: modules/graphics.nix probes /proc for the GPU.
  if [ -x "$HOME/.nix-profile/bin/home-manager" ]; then
    "$HOME/.nix-profile/bin/home-manager" switch --impure --flake "$flake_path#stubbe"
    return 0
  fi

  # First run: no `home-manager` binary yet. Build the activation package
  # straight out of the flake and run it. This uses the home-manager pinned in
  # our own flake.lock; the `nix-channel` + `nix-shell '<home-manager>' -A
  # install` bootstrap it replaces pulled an unpinned master (free to drift
  # from the one the config is written against) and left channel state behind
  # that modules/nix.nix then has to prune. programs.home-manager.enable puts
  # the real binary on PATH from here on.
  activation=$(/nix/var/nix/profiles/default/bin/nix build --no-link --print-out-paths \
    --extra-experimental-features 'nix-command flakes' --impure \
    "$flake_path#homeConfigurations.stubbe.activationPackage")
  "$activation/activate"
}

main "$@"
